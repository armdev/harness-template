# Copy to .env and adjust. Every variable has a working default in docker-compose.yml;
# the topology sensor (T8) fails when compose uses a variable that is not listed here.

# --- storage and images
DATA_DIR=/var/tmp/air-harness          # persistent data (postgres, kafka, ollama); never inside the repository
APP_TAG=dev                         # tag of locally built application images
BUSYBOX_TAG=1.37
FLYWAY_TAG=11.12-alpine
KAFKA_TAG=3.9.1
POSTGRES_TAG=17.6-alpine
PROMETHEUS_TAG=v3.6.0
OLLAMA_TAG=0.12.3

# --- runtime
LOG_LEVEL=INFO
GATEWAY_PORT=8080
PROMETHEUS_PORT=9090
OLLAMA_PORT=11434
KAFKA_HEAP_OPTS=-Xmx512m -Xms256m

# --- database (dev defaults; set real secrets outside development)
POSTGRES_DB=air_harness
POSTGRES_PASSWORD=postgres-dev
CONTENT_DB_PASSWORD=content-dev
SEARCH_DB_PASSWORD=search-dev

# --- harness: LLM-backed sensors (review agent, eval judge). Any OpenAI-compatible endpoint.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen3:8b
REVIEW_MODEL=                       # stronger model for review than for generation, if you have one
REVIEW_DIFF_BASE=                   # empty = staged, else working tree; CI: origin/main
EVAL_TOLERANCE=0.05
JUDGE_BASE_URL=                     # empty = IR metrics only, no LLM judge
JUDGE_MODEL=qwen3:8b
JUDGE_API_KEY=not-needed
HARNESS_IMAGE=air-harness-runner:0.2.0     # pinned runner image
HARNESS_TIMEOUT=300                 # seconds per sensor
LLM_NO_THINK=true                   # disable thinking on Qwen3-style models (faster, JSON-only replies)
MIGRATIONS_BASE=HEAD                # migrations M3 compares against this; CI: origin/main
HARNESS_UID=1000                    # set by make; owner of files the harness writes to .harness/
HARNESS_GID=1000

# --- run.sh / help.sh only
PUBLIC_HOST=localhost                # host name printed in URLs (e.g. a VM or remote docker host)
